# SuperSEOToolkit .htaccess Configuration
# Local XAMPP Development Setup

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /superseotoolkit/

    # Remove trailing slashes from directories
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [L,R=301]

    # Add trailing slash to directories
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} !/$
    RewriteRule ^(.+)$ /$1/ [L,R=301]

    # Route all requests to index.html if file/folder doesn't exist
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/index\.html$
    # RewriteRule ^(.*)$ /index.html [L]
</IfModule>

# Enable GZIP Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml+rss application/rss+xml application/atom+xml image/svg+xml
</IfModule>

# Cache Headers for Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 2 weeks"

    # HTML files - revalidate frequently
    ExpiresByType text/html "access plus 1 day"

    # CSS files
    ExpiresByType text/css "access plus 30 days"

    # JavaScript files
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType text/javascript "access plus 30 days"

    # Images
    ExpiresByType image/jpeg "access plus 60 days"
    ExpiresByType image/gif "access plus 60 days"
    ExpiresByType image/png "access plus 60 days"
    ExpiresByType image/webp "access plus 60 days"
    ExpiresByType image/svg+xml "access plus 60 days"

    # Fonts
    ExpiresByType font/truetype "access plus 1 year"
    ExpiresByType font/opentype "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# Cache Control Headers
<IfModule mod_headers.c>
    # HTML files - no cache
    <FilesMatch "\.html?$">
        Header set Cache-Control "max-age=86400, must-revalidate"
    </FilesMatch>

    # CSS and JavaScript - long cache
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>

    # Images - very long cache
    <FilesMatch "\.(jpg|jpeg|png|gif|ico|webp|svg)$">
        Header set Cache-Control "max-age=5184000, public"
    </FilesMatch>

    # Fonts - permanent cache
    <FilesMatch "\.(ttf|otf|eot|woff|woff2)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>

    # XML files - revalidate
    <FilesMatch "\.(xml|json)$">
        Header set Cache-Control "max-age=3600, must-revalidate"
    </FilesMatch>

    # Add CORS headers for fonts
    <FilesMatch "\.(ttf|otf|eot|woff|woff2)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"

    # Enable XSS protection
    Header set X-XSS-Protection "1; mode=block"

    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>

# Disable directory listing
Options -Indexes

# Block access to sensitive files
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to specific files
<FilesMatch "(\.htaccess|\.htpasswd|\.git|\.gitignore|composer\.json|composer\.lock|package\.json|package-lock\.json|\.env|\.env\.example)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Allow access to robots.txt and sitemap
<FilesMatch "^(robots|sitemap)\.xml$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

# Set proper MIME types
AddType text/html .html
AddType text/css .css
AddType text/javascript .js
AddType application/json .json
AddType image/svg+xml .svg
AddType application/xml .xml
AddType text/plain .txt

# Local Development Settings
# Uncomment to enable (for debugging)
# php_flag display_errors On
# php_flag display_startup_errors On
# php_value error_reporting E_ALL
